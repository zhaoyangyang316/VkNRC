#version 460
#extension GL_GOOGLE_include_directive : require
#include "Constant.glsl"
#define WORKGROUP_SIZE 128
#define WEIGHTS_BINDING 0
#define DWEIGHTS_BINDING 1
#include "NN_khr.glsl"
layout(local_size_x=128) in;
layout(std430,binding=2) readonly buffer Input { uvec4 words[]; };
layout(std430,binding=3) readonly buffer Target { vec4 targets[]; };
layout(std430,binding=4) writeonly buffer Output { vec4 preds[]; };
void main() {
	uint i=gl_GlobalInvocationID.x;
	uvec4 input_words[8];
	for (uint j=0;j<8;++j) input_words[j]=words[i*8+j];
	vec3 rgb=evaluateKHR(input_words,targets[i].rgb);
	preds[i]=vec4(rgb,1);
}
