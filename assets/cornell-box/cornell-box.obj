# Cornell Box measured geometry, adapted to Wavefront OBJ for VkNRC.
# Source: Cornell University Program of Computer Graphics, public-use data:
# https://bowers.cornell.edu/computer-graphics/data
# Former URL: https://www.graphics.cornell.edu/online/box/data.html
# Original measured millimeter coordinates transformed by (X,Y,Z)->(-X,Y,-Z).
# Room dimensions: 556 x 548.8 x 559.2; rotated blocks: heights 165 and 330.
# Measured quads are triangulated; the ceiling is split around its light hole.
# No bottom faces are added beneath the blocks, as in the source geometry.
# RGB materials approximate the source spectra; this is not a spectral reference.
# After VkNRC normalization: camera (0,-0.005007153,3.861230329), yaw/pitch 0.
# Reference vertical FOV: 39.3076481 degrees. Original camera image was square.
# Camera-facing front is open; use a black environment for Cornell-box lighting.
mtllib cornell-box.mtl

v -552.8 0.0 0.0
v 0.0 0.0 0.0
v 0.0 0.0 -559.2
v -549.6 0.0 -559.2
v 0.0 548.8 -559.2
v -556.0 548.8 -559.2
v 0.0 548.8 0.0
v -556.0 548.8 0.0
v -343.0 548.8 -227.0
v -343.0 548.8 -332.0
v -213.0 548.8 -332.0
v -213.0 548.8 -227.0
v -213.0 548.8 0.0
v -213.0 548.8 -559.2
v -343.0 548.8 -559.2
v -343.0 548.8 0.0
v -130.0 165.0 -65.0
v -82.0 165.0 -225.0
v -240.0 165.0 -272.0
v -290.0 165.0 -114.0
v -290.0 0.0 -114.0
v -240.0 0.0 -272.0
v -130.0 0.0 -65.0
v -82.0 0.0 -225.0
v -423.0 330.0 -247.0
v -265.0 330.0 -296.0
v -314.0 330.0 -456.0
v -472.0 330.0 -406.0
v -423.0 0.0 -247.0
v -472.0 0.0 -406.0
v -314.0 0.0 -456.0
v -265.0 0.0 -296.0

o floor
usemtl white
f 1 2 3
f 1 3 4

o back_wall
usemtl white
f 4 3 5
f 4 5 6

