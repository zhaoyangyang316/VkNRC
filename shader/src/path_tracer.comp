#version 460
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_memory_scope_semantics : enable
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#define MAX_BOUNCE 64
#define MAX_TRAIN_RECORDS 8
#define T_MIN 1e-6
#define T_MAX 4.0
#define C 0.01

#include "CookTorranceBRDF.glsl"
#include "NRCRecord.glsl"

#define SCENE_TLAS_BINDING 0
#define SCENE_TEXTURE_BINDING 8
#define SCENE_TEXTURE_NUM_CONST_ID 0
#define SCENE_BUFFERS_FIRST_BINDING 1
#include "Scene.glsl"

#define METHOD_NONE 0
#define METHOD_NRC 1
#define METHOD_CACHE 2

layout(push_constant) uniform uuPushConstant {
	vec3 uOrigin, uLook, uSide, uUp;
	uint uSeed;
	uvec2 uExtent;
	uint uLeftMethod, uRightMethod;
	float uTrainProbability;
	uint uMaxBounces;
	uint uUseNEE;
	uint uIndirectOnly;
	uint uFastMode;
	float uMinRoughness;
};

// V-Buffer
layout(binding = 9) uniform usampler2D uPrimitiveID_InstanceID;
// NRC
layout(binding = 12) buffer uuEvalCount { uint uEvalCount; };
layout(std430, binding = 13) writeonly buffer uuEvalRecords { NRCEvalRecord uEvalRecords[]; };
layout(binding = 14) buffer uuBatchTrainCounts { uint count; }
uBatchTrainCounts[NRC_TRAIN_BATCH_COUNT];
layout(std430, binding = 15) writeonly buffer uuBatchTrainRecords { NRCTrainRecord records[]; }
uBatchTrainRecords[NRC_TRAIN_BATCH_COUNT];

layout(binding = 16, rgba32f) writeonly uniform image2D uBias_FactorR;
layout(binding = 17, rg32f) writeonly uniform image2D uFactorGB;

// Uniform selection of emissive triangles, followed by uniform surface-area
// sampling. The second buffer allows constant-time PDF evaluation on BSDF hits.
layout(constant_id = 2) const uint kLightCount = 0;
layout(std430, binding = 18) readonly buffer uuLights { uvec2 uLights[]; };
layout(std430, binding = 19) readonly buffer uuLightMembership { uint uLightMembership[]; };

struct Ray {
	vec3 o, d;
};

struct Hit {
	vec3 position;
	uint primitive_id;
	vec3 normal;
	uint instance_id;
	vec2 texcoord;
	vec2 barycentric;
	Material material;
	vec3 diffuse;
	vec3 specular;
	vec3 emission;
	bool flip_normal;
};

Hit GetVBufferHit(in const uint primitive_id, in const uint instance_id, in const Ray ray) {
	vec2 texcoord_0 = GetSceneTexcoord(primitive_id, 0);
	vec2 texcoord_1 = GetSceneTexcoord(primitive_id, 1);
	vec2 texcoord_2 = GetSceneTexcoord(primitive_id, 2);
	vec3 vertex_0 = GetSceneVertex(instance_id, primitive_id, 0);
	vec3 vertex_1 = GetSceneVertex(instance_id, primitive_id, 1);
	vec3 vertex_2 = GetSceneVertex(instance_id, primitive_id, 2);
	vec3 v01 = vertex_1 - vertex_0, v02 = vertex_2 - vertex_0, v0o = ray.o - vertex_0;
	vec3 n = cross(v01, v02);
	vec3 q = cross(v0o, ray.d);
	float d = 1.0 / dot(ray.d, n);
	float u = d * dot(-q, v02);
	float v = d * dot(q, v01);
	vec3 barycentric = vec3(1.0 - u - v, u, v);

	n = normalize(n);

	Hit hit;
	hit.flip_normal = dot(n, ray.d) >= 0;
	hit.normal = hit.flip_normal ? -n : n;
	hit.primitive_id = primitive_id;
	hit.instance_id = instance_id;
	hit.barycentric = barycentric.yz;
	// Add local edge offsets to the base vertex last. This preserves constant
	// coordinates on planar faces and avoids spurious secondary hits at grazing angles.
	hit.position = vertex_0 + (u * v01 + v * v02);
	hit.texcoord = mat3x2(texcoord_0, texcoord_1, texcoord_2) * barycentric;
	hit.material = GetSceneMaterial(primitive_id);
	hit.diffuse = GetSceneDiffuse(hit.material, hit.texcoord);
	hit.emission = GetSceneEmission(hit.material, hit.texcoord);
	hit.specular = GetSceneSpecular(hit.material, hit.texcoord);

	return hit;
}

Hit GetRayQueryHit(in const rayQueryEXT ray_query, in const Ray ray) {
	// Base PrimitiveID + Instance PrimitiveID
	uint primitive_id = rayQueryGetIntersectionInstanceCustomIndexEXT(ray_query, true) +
	                    rayQueryGetIntersectionPrimitiveIndexEXT(ray_query, true);
	uint instance_id = rayQueryGetIntersectionInstanceIdEXT(ray_query, true);

	vec2 texcoord_0 = GetSceneTexcoord(primitive_id, 0);
	vec2 texcoord_1 = GetSceneTexcoord(primitive_id, 1);
	vec2 texcoord_2 = GetSceneTexcoord(primitive_id, 2);
	vec3 vertex_0 = GetSceneVertex(instance_id, primitive_id, 0);
	vec3 vertex_1 = GetSceneVertex(instance_id, primitive_id, 1);
	vec3 vertex_2 = GetSceneVertex(instance_id, primitive_id, 2);
	vec3 n = normalize(cross(vertex_1 - vertex_0, vertex_2 - vertex_0));

	vec3 barycentric = vec3(0, rayQueryGetIntersectionBarycentricsEXT(ray_query, true));
	barycentric.x = 1.0 - barycentric.y - barycentric.z;

	Hit hit;
	hit.flip_normal = dot(n, ray.d) >= 0;
	hit.normal = hit.flip_normal ? -n : n;
	hit.primitive_id = primitive_id;
	hit.instance_id = instance_id;
	hit.barycentric = barycentric.yz;
	hit.position = vertex_0 + (barycentric.y * (vertex_1 - vertex_0) + barycentric.z * (vertex_2 - vertex_0));
	hit.texcoord = mat3x2(texcoord_0, texcoord_1, texcoord_2) * barycentric;
	hit.material = GetSceneMaterial(primitive_id);
	hit.diffuse = GetSceneDiffuse(hit.material, hit.texcoord);
	hit.specular = GetSceneSpecular(hit.material, hit.texcoord);
	hit.emission = GetSceneEmission(hit.material, hit.texcoord);
	return hit;
}

CookTorranceBRDFArgs GetHitBRDFArgs(in const Hit hit) {
	CookTorranceBRDFArgs args;
	args.diffuse = hit.diffuse;
	args.specular = hit.specular;
	args.roughness = max(hit.material.roughness, 0.001);
	args.ior = max(hit.material.ior, 1.5);
	return args;
}

// Use a constant environment only when the scene has no emissive surfaces.
layout(constant_id = 1) const float kEnvironmentIntensity = 10.0;
const vec3 kConstLight = vec3(kEnvironmentIntensity);

vec3 NormalizeRGB(in const vec3 rgb) { return !any(isnan(rgb)) && !any(isinf(rgb)) ? max(rgb, vec3(0)) : vec3(0); }

struct BRDFStepInfo {
	vec3 color;
	float cosine;
	Ray ray;
	float pdf;
	float dist2;
};

float _distance_2(in const vec3 l, in const vec3 r) {
	vec3 d = l - r;
	return dot(d, d);
}

PackedNRCInput MakeNRCInput(in const Hit hit, in const vec3 d) {
	PackedNRCInput i;
	i.primitive_id = hit.primitive_id;
	i.flip_bit_instance_id = hit.instance_id | (uint(hit.flip_normal) << 31u);
	i.barycentric_2x16U = packUnorm2x16(hit.barycentric);
	i.scattered_dir_2x16U = packUnorm2x16(NRCSphEncode(d));
	return i;
}

BRDFStepInfo BRDFStep(in const Hit hit, in const Ray ray) {
	CookTorranceBRDFArgs brdf_args = GetHitBRDFArgs(hit);
	vec3 dir;
	float pdf;
	{
		vec4 sample_dir_pdf = CookTorranceSample(brdf_args, -ray.d, hit.normal);
		dir = sample_dir_pdf.xyz;
		pdf = sample_dir_pdf.w;
	}
	vec3 brdf = CookTorranceBRDF(brdf_args, dir, -ray.d, hit.normal); // sample_dir is incidence dir
	float cosine = abs(dot(hit.normal, dir));
	vec3 color = NormalizeRGB(brdf * cosine / pdf);
	BRDFStepInfo info;
	info.color = color;
	info.ray = Ray(hit.position, dir);
	info.cosine = cosine;
	info.pdf = pdf;
	info.dist2 = _distance_2(ray.o, hit.position);
	return info;
}

BRDFStepInfo BRDFQuery(in const Hit hit, in const Ray ray, in const vec3 dir) {
	CookTorranceBRDFArgs brdf_args = GetHitBRDFArgs(hit);
	float pdf = CookTorrancePDF(brdf_args, dir, -ray.d, hit.normal);
	vec3 brdf = CookTorranceBRDF(brdf_args, dir, -ray.d, hit.normal);
	float cosine = abs(dot(hit.normal, dir));
	vec3 color = NormalizeRGB(brdf * cosine / pdf);
	BRDFStepInfo info;
	info.color = color;
	info.ray = Ray(hit.position, dir);
	info.cosine = cosine;
	info.pdf = pdf;
	info.dist2 = _distance_2(ray.o, hit.position);
	return info;
}

float PowerMIS(float sampled_pdf, float other_pdf) {
	// Scale before squaring to avoid overflow for small or nearly edge-on lights.
	if (!(sampled_pdf > 0.0))
		return 0.0;
	if (!(other_pdf > 0.0))
		return 1.0;
	if (isinf(sampled_pdf))
		return isinf(other_pdf) ? 0.5 : 1.0;
	if (isinf(other_pdf))
		return 0.0;
	float scale = max(sampled_pdf, other_pdf);
	float a = sampled_pdf / scale, b = other_pdf / scale;
	return a * a / (a * a + b * b);
}

float TriangleLightPDF(in const uint primitive_id, in const uint instance_id,
                       in const vec3 origin, in const vec3 point) {
	if (kLightCount == 0 || uLightMembership[primitive_id] == 0)
		return 0.0;
	vec3 a = GetSceneVertex(instance_id, primitive_id, 0);
	vec3 b = GetSceneVertex(instance_id, primitive_id, 1);
	vec3 c = GetSceneVertex(instance_id, primitive_id, 2);
	vec3 area_normal = cross(b - a, c - a);
	float twice_area = length(area_normal);
	vec3 delta = point - origin;
	float distance2 = dot(delta, delta);
	if (!(twice_area > 0.0) || !(distance2 > 0.0))
		return 0.0;
	// Emission is two-sided in GetSceneEmission and on ordinary path hits.
	float light_cosine = abs(dot(area_normal / twice_area, delta * inversesqrt(distance2)));
	if (!(light_cosine > 0.0))
		return 0.0;
	return 2.0 * distance2 / (float(kLightCount) * twice_area * light_cosine);
}

bool ShadowVisible(in const vec3 origin, in const vec3 direction, in const float distance) {
	rayQueryEXT shadow;
	rayQueryInitializeEXT(shadow, uTLAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
	                      0xFF, origin, T_MIN, direction, distance);
	while (rayQueryProceedEXT(shadow))
		;
	return rayQueryGetIntersectionTypeEXT(shadow, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 SampleDirectLight(in const Hit hit, in const Ray incoming_ray) {
	if (uUseNEE == 0)
		return vec3(0);
	vec3 direction, emission;
	float light_pdf, shadow_distance;
	if (kLightCount != 0) {
		// Guard the discrete index against rounding when converting the count.
		uvec2 light = uLights[min(uint(RNGNext() * float(kLightCount)), kLightCount - 1u)];
		float r = sqrt(RNGNext()), s = RNGNext();
		vec3 barycentric = vec3(1.0 - r, r * (1.0 - s), r * s);
		vec3 point = GetSceneVertex(light.y, light.x, 0) * barycentric.x +
		             GetSceneVertex(light.y, light.x, 1) * barycentric.y +
		             GetSceneVertex(light.y, light.x, 2) * barycentric.z;
		vec3 delta = point - hit.position;
		float distance = length(delta);
		if (!(distance > 2.0 * T_MIN) || distance > T_MAX)
			return vec3(0);
		direction = delta / distance;
		light_pdf = TriangleLightPDF(light.x, light.y, hit.position, point);
		vec2 uv = GetSceneTexcoord(light.x, 0) * barycentric.x +
		          GetSceneTexcoord(light.x, 1) * barycentric.y +
		          GetSceneTexcoord(light.x, 2) * barycentric.z;
		emission = GetSceneEmission(GetSceneMaterial(light.x), uv);
		// Exclude the sampled endpoint itself from the visibility test. The
		// relative margin covers floating-point intersection error in this scene.
		shadow_distance = distance - max(2.0 * T_MIN, distance * 1e-5);
		if (shadow_distance <= T_MIN)
			return vec3(0);
	} else if (kEnvironmentIntensity > 0.0) {
		// The fallback environment is constant, so cosine-hemisphere sampling
		// is effective and its PDF is also available for BSDF escape rays.
		vec4 sample_dir_pdf = SampleCosineWeighted(hit.normal);
		direction = sample_dir_pdf.xyz;
		light_pdf = sample_dir_pdf.w;
		emission = kConstLight;
		shadow_distance = T_MAX;
	} else {
		return vec3(0);
	}

	float cosine = dot(hit.normal, direction);
	if (!(cosine > 0.0) || !(light_pdf > 0.0) || isinf(light_pdf) ||
	    !any(greaterThan(emission, vec3(0))))
		return vec3(0);
	CookTorranceBRDFArgs args = GetHitBRDFArgs(hit);
	float brdf_pdf = CookTorrancePDF(args, direction, -incoming_ray.d, hit.normal);
	vec3 direct = CookTorranceBRDF(args, direction, -incoming_ray.d, hit.normal) * emission *
	              (cosine * PowerMIS(light_pdf, brdf_pdf) / light_pdf);
	if (!any(greaterThan(direct, vec3(0))) || !ShadowVisible(hit.position, direction, shadow_distance))
		return vec3(0);
	return NormalizeRGB(direct);
}

struct PathTraceResult {
	vec3 bias, factor;
};

void PushScreenQuery(in const Hit hit, in const Ray incoming_ray) {
	uint eval_id = atomicAdd(uEvalCount, 1u, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer, gl_SemanticsRelaxed);
	NRCEvalRecord record;
	record.dst = EncodeNRCEvalDstScreen(gl_GlobalInvocationID.xy);
	record.packed_input = MakeNRCInput(hit, -incoming_ray.d);
	uEvalRecords[eval_id] = record;
}

// Cache scattered radiance S_i toward the previous path vertex, excluding E_i.
// A training target obeys S_i = w_i * (E_(i+1) + S_(i+1)). At a cache endpoint k,
// every earlier record is bias_i + factor_i * S_k; endpoint k is not self-labelled.
PathTraceResult TracePath(Hit hit, Ray ray, in const uint method, in const bool train) {
	vec3 train_bias[MAX_TRAIN_RECORDS], train_factor[MAX_TRAIN_RECORDS];
	PackedNRCInput train_input[MAX_TRAIN_RECORDS];
	uint train_count = 0;
	bool train_active = train, render_active = true, bootstrap = false;
	PackedNRCInput bootstrap_input;
	// Anchor 1/16 of training paths with actual traced transport instead of a
	// learned terminal value. Roulette ends these paths; the common trace limit
	// also applies to the plain path tracer (64 vertices by default).
	bool unbiased_training = train && RNGNext() < (1.0 / 16.0);

	vec3 radiance = vec3(0), render_weight = vec3(1), path_weight = vec3(1);
	PathTraceResult result = PathTraceResult(vec3(0), vec3(0));
	bool fast_mode = uFastMode != 0;
	float threshold = 0.0;
	if (!fast_mode) {
		float primary_cosine = abs(dot(hit.normal, -ray.d));
		float primary_spread = _distance_2(ray.o, hit.position) / (4.0 * M_PI * max(primary_cosine, 1e-12));
		threshold = C * primary_spread;
	}
	float spread_sum = 0.0, suffix_spread_sum = 0.0;
	bool suffix_started = false;
	uint max_bounces = clamp(uMaxBounces, 1u, uint(MAX_BOUNCE));
	float emission_mis = 1.0; // Directly visible emitters have no competing NEE sample.

	for (uint vertex = 0; vertex < max_bounces; ++vertex) {
		// Emission at this vertex contributes to preceding vertices, but not to
		// the scattered-radiance target stored at this vertex itself.
		// Indirect-only keeps paths with at least two scattering vertices:
		// E_0 is visible emission, and w_0 * E_1 is primary direct lighting.
		// Training still learns full scattered radiance at every vertex.
		if (render_active && (uIndirectOnly == 0 || vertex > 1))
			radiance += render_weight * hit.emission * emission_mis;
		if (train_active) {
			for (uint i = 0; i < train_count; ++i)
				train_bias[i] += train_factor[i] * hit.emission * emission_mis;
		}
		// Count the primary surface as vertex one. At the limit retain its
		// emission but do not append any cache contribution or training bootstrap.
		// Earlier cache queries can still summarize additional transport because
		// remaining depth is not an input to the network.
		if (vertex + 1 == max_bounces)
			break;

		// Treat weak specular reflection as diffuse for the cache decision:
		// every resolved linear RGB channel (including map_Ks) must be below 0.01.
		// This changes cache termination only, for both rendering and training.
		float termination_roughness = all(lessThan(hit.specular, vec3(0.01))) ? 1.0 : hit.material.roughness;
		bool rough_hit = termination_roughness > uMinRoughness;
		// S_0 contains primary direct lighting. Trace the first scatter explicitly
		// (including its MIS-weighted light hit or escape) in both NRC views.
		// At a secondary hit, emission was handled above and S_i contributes only GI.
		bool nrc_endpoint = vertex > 0 && (fast_mode ? rough_hit : spread_sum * spread_sum > threshold);
		bool debug_query = method == METHOD_CACHE && (uIndirectOnly == 0 || vertex > 0);
		if (render_active && (debug_query || (method == METHOD_NRC && nrc_endpoint))) {
			PushScreenQuery(hit, ray);
			result = PathTraceResult(radiance, render_weight);
			render_active = false;
		}

		// The first eligible hit starts the suffix and receives a training target.
		// Only a later hit may supply the cached value for that target.
		bool suffix_endpoint =
		    suffix_started && (fast_mode ? rough_hit : suffix_spread_sum * suffix_spread_sum > threshold);
		if (train_active && !unbiased_training &&
		    (suffix_endpoint || (!fast_mode && train_count == MAX_TRAIN_RECORDS))) {
			bootstrap_input = MakeNRCInput(hit, -ray.d);
			bootstrap = true;
			train_active = false;
		}
		// Training coverage and suffix length do not depend on the displayed
		// method; even pixels in the plain-PT half supply training records.
		if (!suffix_started && nrc_endpoint) {
			suffix_started = true;
			suffix_spread_sum = 0.0;
		}
		if (!render_active && !train_active)
			break;
		// Reserve a target for the first eligible rough hit even after a long smooth prefix.
		uint record_limit = fast_mode && !suffix_started ? MAX_TRAIN_RECORDS - 1u : MAX_TRAIN_RECORDS;
		if (train_active && train_count < record_limit) {
			train_input[train_count] = MakeNRCInput(hit, -ray.d);
			train_bias[train_count] = vec3(0);
			train_factor[train_count] = vec3(1);
			++train_count;
		}

		// Cache endpoints above represent the entire scattered radiance at that
		// vertex, including direct light. Only continuing estimators add NEE here.
		// Include the newly created record: direct illumination is part of S_i,
		// whereas local emission (added before record creation) is not.
		vec3 direct = SampleDirectLight(hit, ray);
		// Still sample at vertex zero to preserve training and random sequences.
		if (render_active && (uIndirectOnly == 0 || vertex > 0))
			radiance += render_weight * direct;
		if (train_active) {
			for (uint i = 0; i < train_count; ++i)
				train_bias[i] += train_factor[i] * direct;
		}

		BRDFStepInfo step = BRDFStep(hit, ray);
		if (!any(greaterThan(step.color, vec3(0))))
			break;
		path_weight *= step.color;
		// The survival correction is included in every active estimator, both
		// screen throughput and all training suffixes, so roulette loses no energy.
		if (vertex >= 3) {
			float survival = clamp(max(path_weight.r, max(path_weight.g, path_weight.b)), 0.05, 0.95);
			if (RNGNext() >= survival)
				break;
			step.color /= survival;
			path_weight /= survival;
		}
		if (render_active)
			render_weight *= step.color;
		if (train_active) {
			for (uint i = 0; i < train_count; ++i)
				train_factor[i] *= step.color;
		}

		ray = step.ray;
		rayQueryEXT ray_query;
		rayQueryInitializeEXT(ray_query, uTLAS, gl_RayFlagsOpaqueEXT, 0xFF, ray.o, T_MIN, ray.d, T_MAX);
		while (rayQueryProceedEXT(ray_query))
			;
		if (rayQueryGetIntersectionTypeEXT(ray_query, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
			float environment_mis = uUseNEE != 0 && kEnvironmentIntensity > 0.0 && kLightCount == 0
			                            ? PowerMIS(step.pdf, max(dot(hit.normal, ray.d), 0.0) / M_PI)
			                            : 1.0;
			if (render_active && (uIndirectOnly == 0 || vertex > 0))
				radiance += render_weight * kConstLight * environment_mis;
			if (train_active) {
				for (uint i = 0; i < train_count; ++i)
					train_bias[i] += train_factor[i] * kConstLight * environment_mis;
			}
			break;
		}
		hit = GetRayQueryHit(ray_query, ray);
		// Balance only the emitter hit against NEE at its predecessor. A cache
		// prediction at this hit is a separate scattered-radiance contribution.
		emission_mis = uUseNEE != 0
		                   ? PowerMIS(step.pdf, TriangleLightPDF(hit.primitive_id, hit.instance_id, ray.o, hit.position))
		                   : 1.0;
		// Eq. 3 uses the predecessor's sampled-direction PDF and the arriving
		// ray's cosine at this vertex, not a new sample at the current vertex.
		if (!fast_mode) {
			float arrival_cosine = abs(dot(hit.normal, -ray.d));
			float spread_step = sqrt(_distance_2(ray.o, hit.position) / max(step.pdf * arrival_cosine, 1e-12));
			spread_sum += spread_step;
			if (suffix_started)
				suffix_spread_sum += spread_step;
		}
	}

	if (render_active)
		result = PathTraceResult(radiance, vec3(0));

	if (train_count > 0) {
		uint batch = min(uint(RNGNext() * NRC_TRAIN_BATCH_COUNT), NRC_TRAIN_BATCH_COUNT - 1u);
		uint first = atomicAdd(uBatchTrainCounts[batch].count, train_count, gl_ScopeQueueFamily,
		                       gl_StorageSemanticsBuffer, gl_SemanticsRelaxed);
		if (first < NRC_TRAIN_BATCH_SIZE) {
			uint count = min(train_count, NRC_TRAIN_BATCH_SIZE - first);
			for (uint i = 0; i < count; ++i) {
				NRCTrainRecord record;
				record.bias_r = train_bias[i].r;
				record.bias_g = train_bias[i].g;
				record.bias_b = train_bias[i].b;
				vec3 factor = bootstrap ? train_factor[i] : vec3(0);
				record.factor_r = factor.r;
				record.factor_g = factor.g;
				record.factor_b = factor.b;
				record.packed_input = train_input[i];
				uBatchTrainRecords[batch].records[first + i] = record;
			}
			if (bootstrap) {
				uint eval_id = atomicAdd(uEvalCount, 1u, gl_ScopeQueueFamily, gl_StorageSemanticsBuffer,
				                         gl_SemanticsRelaxed);
				NRCEvalRecord record;
				record.dst = EncodeNRCEvalDstTrain(batch, first, first + count - 1u);
				record.packed_input = bootstrap_input;
				uEvalRecords[eval_id] = record;
			}
		}
	}
	return result;
}

void main() {
	uvec2 coord = gl_GlobalInvocationID.xy;
	uint seed = (((coord.y & 0xFF) << 8) | (coord.x & 0xFF)) + uSeed;
	RNGSetState(seed);
	if (any(greaterThanEqual(coord, uExtent)))
		return;

	uint method = coord.x < uExtent.x / 2 ? uLeftMethod : uRightMethod;
	bool train = false;
	if (subgroupElect())
		train = RNGNext() < uTrainProbability;
	train = subgroupBroadcastFirst(train);

	uvec2 primitive_instance = texelFetch(uPrimitiveID_InstanceID, ivec2(coord), 0).rg;
	PathTraceResult result;
	if (primitive_instance.x == -1u)
		result = PathTraceResult(uIndirectOnly == 0 ? kConstLight : vec3(0), vec3(0));
	else {
		vec2 clip = (vec2(coord) + 0.5) / vec2(uExtent) * 2.0 - 1.0;
		Ray ray = Ray(uOrigin, normalize(uLook + clip.x * uSide + clip.y * uUp));
		Hit hit = GetVBufferHit(primitive_instance.x, primitive_instance.y, ray);
		result = TracePath(hit, ray, method, train);
	}
	result.bias = NormalizeRGB(result.bias);
	result.factor = NormalizeRGB(result.factor);
	imageStore(uBias_FactorR, ivec2(coord), vec4(result.bias, result.factor.r));
	imageStore(uFactorGB, ivec2(coord), vec4(result.factor.gb, 0, 0));
}
